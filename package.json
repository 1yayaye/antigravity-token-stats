{
  "name": "antigravity-token-stats",
  "private": true,
  "version": "1.5.0",
  "description": "Unofficial token-usage dashboard for Google Antigravity 2.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "build:bundle:ide": "node scripts/build-bundle-ide.cjs",
    "build:extension:ide": "node scripts/build-extension-ide.cjs",
    "dev:ide": "npm run build:bundle:ide && npm run build:extension:ide && node scripts/dev-ide.cjs",
    "inspect:ide": "node hosts/antigravity-ide/scripts/inspect-ide.cjs",
    "preview": "vite preview",
    "aggregate": "node scripts/aggregate-stats.cjs",
    "patch": "node hosts/antigravity/scripts/patch-antigravity.cjs",
    "unpatch": "node hosts/antigravity/scripts/unpatch-antigravity.cjs",
    "launch": "node -e \"const { findAntigravityExe } = require('./hosts/antigravity/scripts/patch-antigravity.cjs'); require('child_process').spawn(findAntigravityExe(), [], { detached: true, stdio: 'ignore' }).unref();\"",
    "setup": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "package:release": "node hosts/antigravity/scripts/package-release.cjs",
    "proxy:status": "node scripts/proxy-manager.cjs status",
    "proxy:install": "node scripts/proxy-manager.cjs install",
    "proxy:uninstall": "node scripts/proxy-manager.cjs uninstall",
    "proxy:test": "node scripts/proxy-manager.cjs test",
    "proxy:diagnose": "node scripts/proxy-manager.cjs diagnose",
    "mock:data": "node scripts/generate-mock-data.cjs",
    "test:integration": "node scripts/test-integration.cjs",
    "test": "node scripts/test-all.cjs && node scripts/test-persistent-cache.cjs && node scripts/test-subscription-pricing.cjs && node scripts/test-context-widget.cjs && node scripts/test-proxy-manager.cjs && node scripts/test-dsh-metrics.cjs && node scripts/test-dsh-components.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/vscode": "^1.107.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
