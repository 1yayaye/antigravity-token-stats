{
  "_build": {
    "config": "Release",
    "date": "2026-11-17 21:37:00",
    "arch": "x64"
  },
  "child_injection_mode": "filtered",
  "proxy": {
    "type": "socks5",
    "host": "127.0.0.1",
    "port": 7890
  },
  "fake_ip": {
    "cidr": "198.18.0.0/15",
    "enabled": true
  },
  "traffic_logging": false,
  "timeout": {
    "connect": 5000,
    "recv": 5000,
    "send": 5000
  },
  "diagnostics": {
