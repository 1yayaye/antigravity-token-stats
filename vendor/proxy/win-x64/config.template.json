    "allowed_ports": [
      80,
      443
    ],
    "udp_mode": "auto",
    "ipv6_mode": "proxy",
    "udp_fallback": "block",
    "dns_mode": "direct"
  },
  "child_injection_exclude": [],
  "updates": {
    "enabled": false
  },
  "target_processes": [
    "agy.exe",
    "language_server.exe",
    "language_server_windows_x64.exe",
    "language_server_windows",
    "Antigravity.exe",
    "Antigravity IDE.exe",
    "node.exe"
