  "_comment": "Local process proxy configuration",
  "log_level": "info",
  "ui": {
    "load_notify": "none"
  },
  "child_injection": true,
  "proxy_rules": {
    "routing": {
      "default_action": "proxy",
      "priority_mode": "order",
      "rules": [],
